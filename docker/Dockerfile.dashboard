# ── Stage 1: Build the Vite app ───────────────────────────────────────────────
FROM oven/bun:1 AS builder
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy everything Vite needs to build
COPY src/          ./src/
COPY public/       ./public/
COPY index.html    ./
COPY tsconfig.json ./
COPY vite.config.ts ./

# VITE_API_URL intentionally left empty — the built app uses relative /api/*
# URLs which Traefik routes to the api container at runtime.
RUN bun run build

# ── Stage 2: Serve dist/ with the bundled static server ───────────────────────
FROM oven/bun:1
WORKDIR /app

COPY --from=builder /app/dist       ./dist
COPY docker/static-server.ts        ./static-server.ts

EXPOSE 8080
ENV PORT=8080

CMD ["bun", "run", "static-server.ts"]
