# Stripe API credentials
# Copy this file to .env and fill in your keys
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Webhook secrets — used to verify incoming provider webhooks at POST /api/webhooks/<provider>
# GitHub: Settings → Webhooks → Secret  (HMAC-SHA256 via X-Hub-Signature-256)
# GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
# Vercel: Dashboard → Project → Settings → Webhooks → Signing Secret (HMAC-SHA1 via x-vercel-signature)
# VERCEL_WEBHOOK_SECRET=your_vercel_webhook_secret
# Netlify: Build & Deploy → Deploy notifications → Outgoing webhook → JWT secret (HMAC-SHA256 via X-Webhook-Signature)
# NETLIFY_WEBHOOK_SECRET=your_netlify_webhook_secret
# PayPal: simplified HMAC-SHA256 shared secret (base64 payload-transmission-sig header)
# PAYPAL_WEBHOOK_SECRET=your_paypal_webhook_secret

# Optional: override default ports
API_PORT=3001
# API_HOST=0.0.0.0         # bind address; 0.0.0.0 = all interfaces, 127.0.0.1 = localhost only
FIXTURES_PORT=8080

# Optional: override API base URL in the browser (leave empty to use Vite proxy → localhost:3001)
# VITE_API_URL=http://localhost:3001

# Provider API base URL overrides — useful for local mocks, Stripe CLI, GitHub Enterprise, etc.
# Leave unset to use the default public endpoints.
# STRIPE_API_URL=http://localhost:12111        # Stripe CLI local dev server
# GITHUB_API_URL=https://github.example.com/api/v3  # GitHub Enterprise
# CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
# PAYPAL_API_URL=https://api-m.sandbox.paypal.com   # overrides PAYPAL_ENV when set
# BACKEND_BASE_URL=http://my-service:8000            # prepended when REST-tile proxy url is relative

# ── GitHub Actions ─────────────────────────────────────────────────────────────
# Personal access token with read:org + workflow scopes
GITHUB_TOKEN=your_github_token
# Set one of these (org takes priority):
# GITHUB_ORG=your-org
GITHUB_USER=username

# ── Cloudflare ─────────────────────────────────────────────────────────────────
# API token with Account:Read + Pages:Read + Workers Scripts:Read permissions
CF_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=your_account_id

# ── PayPal ─────────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# 'sandbox' or 'live'
PAYPAL_ENV=sandbox

# ── Vercel ─────────────────────────────────────────────────────────────────────
VERCEL_TOKEN=your_vercel_token
# VERCEL_TEAM_ID=your_team_id   # optional, for team deployments
# VERCEL_POLL_MS=30000

# ── Netlify ────────────────────────────────────────────────────────────────────
NETLIFY_TOKEN=your_netlify_token
# NETLIFY_POLL_MS=30000

# ── CircleCI ───────────────────────────────────────────────────────────────────
# CIRCLECI_TOKEN=your_circleci_token
# CIRCLECI_ORG_SLUG=gh/your-org       # e.g. gh/acme or bb/acme
# CIRCLECI_POLL_MS=60000

# ── Travis CI ──────────────────────────────────────────────────────────────────
# TRAVIS_TOKEN=your_travis_token
# TRAVIS_ORG=your-org-or-username
# TRAVIS_POLL_MS=60000

# ── Bitrise ────────────────────────────────────────────────────────────────────
# BITRISE_TOKEN=your_bitrise_personal_access_token
# BITRISE_POLL_MS=60000

# ── Docker Hub ─────────────────────────────────────────────────────────────────
# DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_access_token   # optional for private repos
# DOCKERHUB_POLL_MS=300000

# ── SonarQube ──────────────────────────────────────────────────────────────────
# SONARQUBE_URL=https://sonarcloud.io
# SONARQUBE_TOKEN=your_sonarqube_token
# SONARQUBE_PROJECT_KEY=your_project_key
# SONARQUBE_POLL_MS=120000

# ── Azure DevOps ───────────────────────────────────────────────────────────────
# AZURE_DEVOPS_ORG=your-org
# AZURE_DEVOPS_TOKEN=your_azure_pat
# AZURE_DEVOPS_PROJECT=your-project   # required for releases + work items
# AZURE_POLL_MS=60000

# ── npm Registry ───────────────────────────────────────────────────────────────
# NPM_PACKAGES=express,lodash,react   # comma-separated package names
# NPM_POLL_MS=3600000

# ── jsDelivr CDN ───────────────────────────────────────────────────────────────
# JSDELIVR_PACKAGES=npm/express,npm/lodash   # comma-separated package specs
# JSDELIVR_POLL_MS=3600000

# ── WakaTime ───────────────────────────────────────────────────────────────────
# WAKATIME_API_KEY=your_wakatime_api_key
# WAKATIME_POLL_MS=300000

# ── Clockify ───────────────────────────────────────────────────────────────────
# CLOCKIFY_API_KEY=your_clockify_api_key
# CLOCKIFY_WORKSPACE_ID=your_workspace_id
# CLOCKIFY_USER_ID=your_user_id   # optional, defaults to current user
# CLOCKIFY_POLL_MS=300000

# ── Linear ─────────────────────────────────────────────────────────────────────
# LINEAR_API_KEY=lin_api_your_key
# LINEAR_POLL_MS=120000

# ── Jira ───────────────────────────────────────────────────────────────────────
# JIRA_HOST=your-org.atlassian.net
# JIRA_EMAIL=your@email.com
# JIRA_API_TOKEN=your_jira_api_token
# JIRA_JQL=project = MY_PROJECT AND status != Done   # optional filter
# JIRA_POLL_MS=120000

# ── Slack ──────────────────────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNELS=C012345678,C087654321   # comma-separated channel IDs
# SLACK_POLL_MS=30000

# ── Discord ────────────────────────────────────────────────────────────────────
# DISCORD_BOT_TOKEN=your_discord_bot_token
# DISCORD_GUILD_IDS=123456789,987654321   # comma-separated guild/server IDs
# DISCORD_POLL_MS=300000

# ── Mailchimp ──────────────────────────────────────────────────────────────────
# MAILCHIMP_API_KEY=your_mailchimp_api_key   # includes datacenter, e.g. abc123-us1
# MAILCHIMP_POLL_MS=300000

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# GA4_PROPERTY_ID=123456789
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}   # inline JSON
# GA4_POLL_MS=3600000

# ── Instatus ───────────────────────────────────────────────────────────────────
# INSTATUS_PAGE_ID=your_page_id
# INSTATUS_API_KEY=your_instatus_api_key
# INSTATUS_POLL_MS=60000

# ── Hacker News ────────────────────────────────────────────────────────────────
# (No API key required — public API)
# HN_POLL_MS=300000

# ── Alpha Vantage ──────────────────────────────────────────────────────────────
# ALPHA_VANTAGE_KEY=your_alphavantage_api_key
# AV_SYMBOLS=AAPL,TSLA,MSFT   # comma-separated stock symbols
# AV_POLL_MS=3600000            # rate-limited: 5 req/min, 500 req/day on free tier

# ── CoinGecko ──────────────────────────────────────────────────────────────────
# (No API key required for public tier)
# COINGECKO_COINS=bitcoin,ethereum,solana   # comma-separated coin IDs
# CG_POLL_MS=300000

# ── Finnhub ────────────────────────────────────────────────────────────────────
# FINNHUB_TOKEN=your_finnhub_api_token
# FH_SYMBOLS=AAPL,TSLA,MSFT   # comma-separated stock symbols
# FINNHUB_POLL_MS=60000

# ── Plaid ──────────────────────────────────────────────────────────────────────
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_secret
# PLAID_ACCESS_TOKEN=access-sandbox-your-token
# PLAID_ENV=sandbox   # or 'development' or 'production'
# PLAID_POLL_MS=300000

# ── HaveIBeenPwned ─────────────────────────────────────────────────────────────
# HIBP_API_KEY=your_hibp_api_key
# HIBP_EMAILS=user@example.com,admin@example.com   # comma-separated emails to monitor
# HIBP_POLL_MS=21600000   # 6 hours (rate-limited: 1 req/1.5s per email)

# ── VirusTotal ─────────────────────────────────────────────────────────────────
# VIRUSTOTAL_API_KEY=your_virustotal_api_key
# VT_DOMAINS=example.com,another.com   # comma-separated domains to scan
# VT_POLL_MS=86400000   # 24 hours (rate-limited: 4 req/min on free tier)

# ── Shodan ─────────────────────────────────────────────────────────────────────
# SHODAN_API_KEY=your_shodan_api_key
# SHODAN_QUERY=org:YourOrg   # Shodan search query
# SHODAN_POLL_MS=3600000

# ── WooCommerce ────────────────────────────────────────────────────────────────
# WC_BASE_URL=https://your-store.com
# WC_CONSUMER_KEY=ck_your_consumer_key
# WC_CONSUMER_SECRET=cs_your_consumer_secret
# WC_POLL_MS=120000

# ── Shopify ────────────────────────────────────────────────────────────────────
# SHOPIFY_SHOP=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_your_access_token
# SHOPIFY_POLL_MS=120000

# ── Reddit ─────────────────────────────────────────────────────────────────────
# (No API key required — uses public JSON API)
# REDDIT_SUBREDDITS=programming,webdev   # comma-separated subreddits (no r/)
# REDDIT_KEYWORDS=                       # optional: filter posts by keyword
# REDDIT_POLL_MS=300000

# ── Product Hunt ───────────────────────────────────────────────────────────────
# PRODUCTHUNT_API_TOKEN=your_producthunt_api_token
# PH_POLL_MS=3600000

# ── SSE poll intervals (milliseconds) ────────────────────────────────────────
# Override server-side polling frequency per resource type.
# Tiles no longer poll — the API server pushes data to all connected clients.
# STRIPE_POLL_MS=30000        # payments, refunds, webhooks (default: 30s)
# STRIPE_SLOW_POLL_MS=60000   # products, subscriptions, customers, invoices (default: 60s)
# STRIPE_REVENUE_POLL_MS=300000 # revenue chart (default: 5 min)
# GITHUB_POLL_MS=30000        # GitHub Actions runs (default: 30s)
# CF_PAGES_POLL_MS=60000      # Cloudflare Pages projects (default: 60s)
# CF_WORKERS_POLL_MS=120000   # Cloudflare Workers scripts (default: 2 min)
# PAYPAL_POLL_MS=60000        # PayPal transactions + balance (default: 60s)

# ── Authentication ─────────────────────────────────────────────────────────────
# Set AUTH_ENABLED=true to require login before accessing the dashboard.
# AUTH_ENABLED=false
# JWT_SECRET=replace_with_a_long_random_secret  # stable across restarts

# Authentication provider: 'local' (default) or 'saml' for SAML 2.0 SSO.
# Local auth uses a username/password stored in auth.db.
# SAML auth delegates login to your identity provider (Okta, Azure AD, Google Workspace, etc.)
# AUTH_PROVIDER=local

# APP_URL: the public URL where the Vite frontend (port 8080) is reachable.
# After SAML login the browser is redirected to APP_URL/?token=<jwt>.
# Local dev:     APP_URL=http://localhost:8080
# Remote/ngrok:  APP_URL=https://<your-ngrok-subdomain>.ngrok-free.app
#                IMPORTANT: ngrok must tunnel port 8080 (Vite), NOT 3001 (API).
#                Vite proxies /api/* → localhost:3001 internally so all tile
#                API calls stay local even when accessed through ngrok.
# APP_URL=http://localhost:8080
#
# ── SAML 2.0 SSO (required when AUTH_PROVIDER=saml) ───────────────────────────
# Option A — point at the XML file exported from your IdP (easiest):
#   Google Workspace: Admin Console → Apps → SAML app → Download metadata
#   Okta:             Applications → app → Sign On → Identity Provider metadata
#   Azure AD:         Enterprise apps → app → Single sign-on → Federation Metadata XML
# SAML_IDP_METADATA_PATH=GoogleIDPMetadata.xml   # relative to project root, or absolute path
#
# Option B — set values manually (used when SAML_IDP_METADATA_PATH is not set):
# Single Sign-On URL from your IdP (the endpoint that receives AuthnRequest).
#   Azure AD:  https://login.microsoftonline.com/<tenantId>/saml2
#   Google WS: https://accounts.google.com/o/saml2/idp?idpid=<idpId>
# SAML_ENTRY_POINT=

# Entity ID / Audience URI — MUST exactly match what is configured in the IdP.
#   Google Workspace: Admin Console → SAML app → Service provider details → Entity ID
#   Okta / Azure AD:  the SP Entity ID / Identifier field in the app config
# SAML_ISSUER=tiling-window-manager

# IdP X.509 certificate (PEM body — copy the base64 block without -----BEGIN/END---- headers).
# Not required when using SAML_IDP_METADATA_PATH (cert is parsed from the XML).
# SAML_CERT=

# Assertion Consumer Service (ACS) URL — must match what you registered with the IdP.
# For local dev use http://localhost:8080/api/auth/saml/callback (proxied by Vite).
# For remote/ngrok use https://<ngrok-subdomain>.ngrok-free.app/api/auth/saml/callback
# SAML_CALLBACK_URL=http://localhost:8080/api/auth/saml/callback

# SP metadata is available at GET /api/auth/saml/metadata for IdP registration.

# ── Docker / Ngrok / Traefik ───────────────────────────────────────────────────
# Required for the Docker Compose stack (docker compose up --build).
# Get your authtoken at https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional: reserved static domain (paid ngrok plans only).
# Free accounts get a random ephemeral subdomain on every restart.
# NGROK_DOMAIN=your-subdomain.ngrok.app

# Port for the Traefik management dashboard (default 8090).
# Access at http://localhost:8090 when the stack is running.
# TRAEFIK_DASHBOARD_PORT=8090
# ── MCP (Model Context Protocol) ──────────────────────────────────────────────
# Enable the MCP server endpoint so LLM agents can query and control the dashboard.
# Disabled by default — set to true to activate GET /api/mcp (SSE) and POST /api/mcp (HTTP).
# MCP_ENABLED=false

# Whether MCP tool calls (add_tile, remove_tile, etc.) require a valid JWT.
# Defaults to the value of AUTH_ENABLED when not set explicitly.
# MCP_AUTH_REQUIRED=false