# ── Stage 1: Install production dependencies ─────────────────────────────────
FROM oven/bun:1 AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

# ── Stage 2: Runtime image ────────────────────────────────────────────────────
FROM oven/bun:1
WORKDIR /app

# Runtime dependencies only (no devDependencies)
COPY --from=deps /app/node_modules ./node_modules

# API source — server.ts, saml.ts, watch.ts, etc.
COPY api/ ./api/

# TypeScript config (Bun uses it for path resolution)
COPY tsconfig.json ./

# Default env — all real secrets are injected at runtime via docker-compose env_file
ENV API_HOST=0.0.0.0
ENV API_PORT=3001

EXPOSE 3001

# Bun runs TypeScript directly — no build step needed
CMD ["bun", "run", "api/server.ts"]
