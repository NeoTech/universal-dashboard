{
  "name": "tiling-window-manager",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "api": "bun run api/server.ts",
    "watch-api": "bun api/watch.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src e2e",
    "lint:fix": "eslint src e2e --fix",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "typecheck": "tsc --noEmit",
    "fixtures": "bun run fixtures/server.ts"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^25.3.1",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "4",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "4"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "alpinejs": "^3.15.8",
    "htmx.org": "^2.0.8",
    "solid-js": "^1.9.11",
    "stripe": "^20.4.0"
  }
}
